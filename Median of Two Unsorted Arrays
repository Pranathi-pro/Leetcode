class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        int tsize=nums1.size()+nums2.size();
        vector<int> marray;
        int i=0;
        int j=0;
        while(i<nums1.size() && j<nums2.size()){
            if(nums1[i]<=nums2[j]){
                marray.push_back(nums1[i]);
                i++;
            }
            else{
                marray.push_back(nums2[j]);
                j++;
            }
        }
        while(i<nums1.size()){
            marray.push_back(nums1[i]);
            i++;

        }
         while(j<nums2.size()){
            marray.push_back(nums2[j]);
            j++;
            
        }
        double median;
        if(tsize%2==0){
            median=(marray[tsize/2]+marray[(tsize/2)-1])/2.0;
    }
    else{
        median=marray[floor(tsize/2)];
    }
    return median;

       
    }
  

    
};
