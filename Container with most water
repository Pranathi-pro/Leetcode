class Solution {
public:
    int maxArea(vector<int>& height) {
        int left=0;
        int right=height.size()-1;
        int ar,area=0,width,hei;
        while(left<right){
            width=right-left;
            hei=min(height[left],height[right]);
             ar=width*hei;
            area=max(area,ar);
            if(hei==height[left]){
                left++;
            }
            else{
                right--;
            }
           
        }
        return area;
    }
};
